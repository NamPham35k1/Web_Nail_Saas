# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database
# Local SQLite for zero-config dev & testing:
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/nailvibe?schema=public"

# Authentication
JWT_SECRET="nailvibe_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Storage
UPLOAD_DIR="./uploads"

